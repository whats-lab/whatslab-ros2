<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>airglove_driver</name>
  <version>0.2.0</version>
  <description>AirGlove ROS 2 driver — Spine 3.0.0 hand joints, wrist, status, alarms and haptics via AirGlove-Client.</description>
  <maintainer email="sdh@whatslab.co.kr">whatslab</maintainer>
  <license>CC BY-NC-ND 4.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>airglove_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
